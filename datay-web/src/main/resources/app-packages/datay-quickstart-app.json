        "dataSourceId": 9000,
        "schema": "main",
        "sql": "CREATE OR REPLACE TABLE ods_date AS\nSELECT\n    strftime(d, '%Y') AS year_id,\n    strftime(d, '%Y') || '年' AS year_name,\n    strftime(d, '%Y') || 'Q' || CAST(quarter(d) AS VARCHAR) AS quarter_id,\n    strftime(d, '%Y') || '年Q' || CAST(quarter(d) AS VARCHAR) AS quarter_name,\n    strftime(d, '%Y%m') AS month_id,\n    strftime(d, '%Y-%m') AS month_name,\n    strftime(d, '%Y%m%d') AS day_id,\n    strftime(d, '%Y-%m-%d') AS day_name,\n    CAST(strftime(d, '%Y%m%d') AS BIGINT) AS date_key,\n    strftime(d, '%Y') || '年/' || strftime(d, '%Y') || '年Q' || CAST(quarter(d) AS VARCHAR) || '/' || strftime(d, '%Y-%m') || '/' || strftime(d, '%Y-%m-%d') AS hierarchy\nFROM (\n    SELECT CAST(UNNEST(generate_series(DATE '2024-01-01', DATE '2026-12-31', INTERVAL 1 DAY)) AS DATE) AS d\n) t;\n\nCREATE OR REPLACE TABLE ods_product_category AS\nSELECT level1_id, level1_name, level2_id, level2_name, member_id, member_name, hierarchy\nFROM (\n    VALUES\n    ('C01', '家用电器', 'C0101', '厨房电器', 'C0101', '厨房电器', '家用电器/厨房电器'),\n    ('C01', '家用电器', 'C0102', '生活电器', 'C0102', '生活电器', '家用电器/生活电器'),\n    ('C01', '家用电器', 'C0103', '影音娱乐', 'C0103', '影音娱乐', '家用电器/影音娱乐'),\n    ('C02', '食品饮料', 'C0201', '休闲零食', 'C0201', '休闲零食', '食品饮料/休闲零食'),\n    ('C02', '食品饮料', 'C0202', '粮油调味', 'C0202', '粮油调味', '食品饮料/粮油调味'),\n    ('C02', '食品饮料', 'C0203', '酒水饮品', 'C0203', '酒水饮品', '食品饮料/酒水饮品')\n) AS t(level1_id, level1_name, level2_id, level2_name, member_id, member_name, hierarchy);\n\nCREATE OR REPLACE TABLE ods_store AS\nSELECT store_id, store_name, store_type, city, open_date\nFROM (\n    VALUES\n    ('S001', '北京朝阳大悦城店', '旗舰店', '北京', DATE '2019-05-18'),\n    ('S002', '上海南京东路店', '旗舰店', '上海', DATE '2020-09-26'),\n    ('S003', '广州天河城店', '标准店', '广州', DATE '2021-03-12'),\n    ('S004', '成都春熙路店', '标准店', '成都', DATE '2022-07-01'),\n    ('S005', '杭州湖滨银泰店', '社区店', '杭州', DATE '2023-11-11')\n) AS t(store_id, store_name, store_type, city, open_date);\n\nCREATE OR REPLACE TABLE ods_order AS\nSELECT order_id,\n       CAST(order_date_key AS BIGINT) AS order_date_key,\n       store_key,\n       category_key,\n       order_status,\n       CAST(quantity AS BIGINT) AS quantity,\n       CAST(order_amount AS DECIMAL(18, 2)) AS order_amount\nFROM (\n    VALUES\n    ('SO20250106001', 20250106, 'S001', 'C0101', 'PAID', 2, 1598.00),\n    ('SO20250106002', 20250106, 'S001', 'C0102', 'PAID', 1, 899.00),\n    ('SO20250106003', 20250106, 'S001', 'C0201', 'SHIPPED', 4, 103.60),\n    ('SO20250106004', 20250106, 'S002', 'C0202', 'PAID', 5, 299.00),\n    ('SO20250106005', 20250106, 'S002', 'C0103', 'COMPLETED', 1, 1299.00),\n    ('SO20250120006', 20250120, 'S003', 'C0101', 'PAID', 3, 2397.00),\n    ('SO20250125007', 20250125, 'S001', 'C0203', 'PAID', 6, 1788.00),\n    ('SO20250125008', 20250125, 'S001', 'C0102', 'SHIPPED', 2, 1798.00),\n    ('SO20250205009', 20250205, 'S002', 'C0101', 'PAID', 1, 799.00),\n    ('SO20250205010', 20250205, 'S002', 'C0201', 'COMPLETED', 8, 207.20),\n    ('SO20250214011', 20250214, 'S004', 'C0202', 'PAID', 3, 179.40),\n    ('SO20250214012', 20250214, 'S004', 'C0103', 'PAID', 2, 2598.00),\n    ('SO20250226013', 20250226, 'S005', 'C0102', 'SHIPPED', 1, 899.00),\n    ('SO20250305014', 20250305, 'S003', 'C0203', 'PAID', 4, 1192.00),\n    ('SO20250305015', 20250305, 'S003', 'C0101', 'PAID', 2, 1598.00),\n    ('SO20250318016', 20250318, 'S002', 'C0102', 'COMPLETED', 1, 899.00),\n    ('SO20250318017', 20250318, 'S002', 'C0201', 'PAID', 5, 129.50),\n    ('SO20250328018', 20250328, 'S004', 'C0103', 'PAID', 1, 1299.00),\n    ('SO20250408019', 20250408, 'S005', 'C0101', 'PAID', 3, 2397.00),\n    ('SO20250408020', 20250408, 'S005', 'C0202', 'SHIPPED', 4, 239.20),\n    ('SO20250419021', 20250419, 'S003', 'C0203', 'PAID', 2, 596.00),\n    ('SO20250419022', 20250419, 'S003', 'C0102', 'PAID', 1, 899.00),\n    ('SO20250427023', 20250427, 'S001', 'C0201', 'COMPLETED', 7, 181.30),\n    ('SO20250506024', 20250506, 'S002', 'C0101', 'PAID', 1, 799.00),\n    ('SO20250506025', 20250506, 'S002'