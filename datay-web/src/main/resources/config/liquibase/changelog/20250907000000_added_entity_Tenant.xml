<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20250907000000001" author="system">
        <!--
          该 changeset 后续调整过种子插入方式，内容已变化；
          放行历史开发库中已记录的老校验和，避免升级时报“校验和不匹配”。
        -->
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="jhi_tenant">
            <column name="id" type="bigint" autoIncrement="true" startWith="1">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="varchar(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="ux_tenant_code"/>
            </column>
            <column name="name" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(500)"/>
            <column name="enabled" type="boolean" valueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(50)"/>
            <column name="created_date" type="timestamp"/>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="timestamp"/>
        </createTable>

        <createTable tableName="jhi_user_tenant">
            <column name="user_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="is_default" type="boolean" valueBoolean="false"/>
        </createTable>

        <addPrimaryKey tableName="jhi_user_tenant" columnNames="user_id, tenant_id"/>

        <addForeignKeyConstraint
            baseTableName="jhi_user_tenant"
            baseColumnNames="tenant_id"
            constraintName="fk_user_tenant_tenant"
            referencedTableName="jhi_tenant"
            referencedColumnNames="id"/>

        <addForeignKeyConstraint
            baseTableName="jhi_user_tenant"
            baseColumnNames="user_id"
            constraintName="fk_user_tenant_user"
            referencedTableName="jhi_user"
            referencedColumnNames="id"/>

        <!--
          内置系统租户。jhi_tenant.id 为自增列：MySQL 会把「显式插入 0」当作
          「生成下一个自增值」，导致系统租户无法落成 id=0。
          这里先普通插入（由数据库生成自增 id），再将该行 id 更新为 0 —— 显式 0 的限制
          只作用于 INSERT，UPDATE 不受影响，因此在 H2 / MySQL 上行为一致，无需按库分支。
        -->
        <insert tableName="jhi_tenant">
            <column name="code" value="system"/>
            <column name="name" value="系统租户"/>
            <column name="description" value="DataY 系统内置租户"/>
            <column name="enabled" valueBoolean="true"/>
            <column name="created_by" value="system"/>
            <column name="created_date" valueComputed="now()"/>
            <column name="last_modified_by" value="system"/>
            <column name="last_modified_date" valueComputed="now()"/>
        </insert>

        <update tableName="jhi_tenant">
            <column name="id" valueNumeric="0"/>
            <where>code = 'system'</where>
        </update>

        <insert tableName="jhi_user_tenant">
            <column name="user_id" valueNumeric="1"/>
            <column name="tenant_id" valueNumeric="0"/>
            <column name="is_default" valueBoolean="true"/>
        </insert>
    </changeSet>

</databaseChangeLog>