<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog-ext.xsd">

    <changeSet id="20261107000000-1-data-quality-rule" author="datafusion">
        <createTable tableName="dp_data_quality_rule">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="rule_name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="rule_code" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="rule_level" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="rule_type" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(2000)">
                <constraints nullable="true"/>
            </column>
            <column name="default_config" type="${clobType}">
                <constraints nullable="true"/>
            </column>
            <column name="severity" type="varchar(20)" defaultValue="ERROR">
                <constraints nullable="true"/>
            </column>
            <column name="enabled" type="boolean" defaultValueBoolean="true">
                <constraints nullable="true"/>
            </column>
            <column name="builtin" type="boolean" defaultValueBoolean="false">
                <constraints nullable="true"/>
            </column>
            <column name="create_time" type="${datetimeType}">
                <constraints nullable="true"/>
            </column>
            <column name="update_time" type="${datetimeType}">
                <constraints nullable="true"/>
            </column>
            <column name="creater" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="tenant_id" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
        </createTable>
        <createIndex tableName="dp_data_quality_rule" indexName="idx_dq_rule_tenant">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex tableName="dp_data_quality_rule" indexName="idx_dq_rule_code">
            <column name="rule_code"/>
        </createIndex>
    </changeSet>

    <changeSet id="20261107010000-1-data-quality-task" author="datafusion">
        <createTable tableName="dp_data_quality_task">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="task_name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="task_desc" type="varchar(2000)">
                <constraints nullable="true"/>
            </column>
            <column name="data_source_id" type="${uuidType}">
                <constraints nullable="false"/>
            </column>
            <column name="schema_name" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="table_name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="where_clause" type="${clobType}">
                <constraints nullable="true"/>
            </column>
            <column name="rule_configs" type="${clobType}">
                <constraints nullable="true"/>
            </column>
            <column name="fail_on_warn" type="boolean" defaultValueBoolean="false">
                <constraints nullable="true"/>
            </column>
            <column name="sample_limit" type="int" defaultValueNumeric="100">
                <constraints nullable="true"/>
            </column>
            <column name="output_format" type="varchar(20)" defaultValue="CSV">
                <constraints nullable="true"/>
            </column>
            <column name="output_dir" type="varchar(500)" defaultValue="data-quality">
                <constraints nullable="true"/>
            </column>
            <column name="job_id" type="${uuidType}">
                <constraints nullable="true"/>
            </column>
            <column name="status" type="varchar(50)">
                <constraints nullable="true"/>
            </column>
            <column name="last_status" type="varchar(50)">
                <constraints nullable="true"/>
            </column>
            <column name="last_run_time" type="${datetimeType}">
                <constraints nullable="true"/>
            </column>
            <column name="create_time" type="${datetimeType}">
                <constraints nullable="true"/>
            </column>
            <column name="update_time" type="${datetimeType}">
                <constraints nullable="true"/>
            </column>
            <column name="creater" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="tenant_id" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
        </createTable>
        <createIndex tableName="dp_data_quality_task" indexName="idx_dq_task_tenant">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex tableName="dp_data_quality_task" indexName="idx_dq_task_job">
            <column name="job_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="20261107020000-1-seed-data-quality-rules" author="datafusion">
        <insert tableName="dp_data_quality_rule">
            <column name="id" value="019a2000-0000-7000-8000-000000000001"/>
            <column name="rule_name" value="表行数下限"/>
            <column name="rule_code" value="DQ_TABLE_ROW_COUNT_MIN"/>
            <column name="rule_level" value="TABLE"/>
            <column name="rule_type" value="ROW_COUNT_MIN"/>
            <column name="description" value="校验表的总行数不小于指定值。"/>
            <column name="default_config" value='{"minRows": 1}'/>
            <column name="severity" value="ERROR"/>
            <column name="enabled" valueBoolean="true"/>
            <column name="builtin" valueBoolean="true"/>
            <column name="create_time" valueComputed="now()"/>
            <column name="update_time" valueComputed="now()"/>
            <column name="creater" value="system"/>
