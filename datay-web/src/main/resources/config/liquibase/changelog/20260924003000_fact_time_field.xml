<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260924003000-1" author="datafusion">
        <addColumn tableName="data_model">
            <column name="time_field" type="varchar(255)">
                <constraints nullable="true" />
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="20260924003000-2" author="datafusion">
        <update tableName="data_model">
            <column name="time_field" value="order_date_sk"/>
            <where>id in (3100, 3101) and (time_field is null or time_field = '')</where>
        </update>
        <update tableName="data_model">
            <column name="time_field" value="event_date_sk"/>
            <where>id = 3102 and (time_field is null or time_field = '')</where>
        </update>
    </changeSet>
</databaseChangeLog>
