<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog-ext.xsd">

    <changeSet id="20260923000000-1" author="datafusion">
        <createTable tableName="dp_metric_directory">
            <column name="id" type="bigint" autoIncrement="true" startWith="2500">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="parent_id" type="bigint">
                <constraints nullable="true" />
            </column>
            <column name="sort_order" type="integer">
                <constraints nullable="true" />
            </column>
            <column name="create_time" type="${datetimeType}">
                <constraints nullable="true" />
            </column>
            <column name="update_time" type="${datetimeType}">
                <constraints nullable="true" />
            </column>
            <column name="tenant_id" type="varchar(255)">
                <constraints nullable="true" />
            </column>
        </createTable>
        <dropDefaultValue tableName="dp_metric_directory" columnName="create_time" columnDataType="${datetimeType}"/>
        <dropDefaultValue tableName="dp_metric_directory" columnName="update_time" columnDataType="${datetimeType}"/>
    </changeSet>

    <changeSet id="20260923000000-2" author="datafusion">
        <createTable tableName="dp_metric">
            <column name="id" type="bigint" autoIncrement="true" startWith="2600">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="code" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="description" type="varchar(2000)">
                <constraints nullable="true" />
            </column>
            <column name="directory_id" type="bigint">
                <constraints nullable="true" />
            </column>
            <column name="metric_type" type="varchar(32)">
                <constraints nullable="true" />
            </column>
            <column name="status" type="varchar(32)">
                <constraints nullable="true" />
            </column>
            <column name="fact_model_id" type="bigint">
                <constraints nullable="true" />
            </column>
            <column name="filter_config" type="${clobType}">
                <constraints nullable="true" />
            </column>
            <column name="unit" type="varchar(64)">
                <constraints nullable="true" />
            </column>
            <column name="data_type" type="varchar(32)">
                <constraints nullable="true" />
            </column>
            <column name="is_additive" type="boolean" defaultValueBoolean="true">
                <constraints nullable="true" />
            </column>
            <column name="formula" type="varchar(2000)">
                <constraints nullable="true" />
            </column>
            <column name="create_time" type="${datetimeType}">
                <constraints nullable="true" />
            </column>
            <column name="update_time" type="${datetimeType}">
                <constraints nullable="true" />
            </column>
            <column name="tenant_id" type="varchar(255)">
                <constraints nullable="true" />
            </column>
        </createTable>
        <dropDefaultValue tableName="dp_metric" columnName="create_time" columnDataType="${datetimeType}"/>
        <dropDefaultValue tableName="dp_metric" columnName="update_time" columnDataType="${datetimeType}"/>
    </changeSet>
</databaseChangeLog>
