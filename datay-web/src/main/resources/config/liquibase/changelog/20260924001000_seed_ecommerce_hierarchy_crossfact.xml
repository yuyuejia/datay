            <column name="code" value="order_amount"/>
            <column name="description" value="订单原始金额合计（订单事实表）。"/>
            <column name="directory_id" valueNumeric="2510"/>
            <column name="metric_type" value="ATOMIC"/>
            <column name="status" value="ENABLED"/>
            <column name="fact_model_id" valueNumeric="3100"/>
            <column name="unit" value="元"/>
            <column name="data_type" value="DECIMAL"/>
            <column name="is_additive" valueBoolean="true"/>
