{
  "version": 2,
  "title": "v2 fixture",
  "description": "Dashboard spec v2 regression fixture",
  "layout": {
    "mode": "standard"
  },
  "datasets": [
    {
      "id": "ds1",
      "type": "METRIC",
      "metricQuery": {
        "metricCodes": [
          "sales_amount"
        ],
        "dimensions": [
          {
            "dimensionModelCode": "dim_month",
            "dimensionFieldNames": [
              "month_name"
            ]
          }
        ]
      }
    }
  ],
  "widgets": [
    {
      "id": "w1",
      "title": "月度销售额",
      "type": "echarts",
      "layout": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 8
      },
      "datasetId": "ds1",
      "encode": {
        "dimensions": [
          {
            "field": "month_name",
            "role": "x"
          }
        ],
        "measures": [
          {
            "field": "sales_amount",
            "name": "销售额",
            "agg": "sum",
            "role": "y"
          }
        ],
        "groupBy": true,
        "sortField": "sales_amount",
        "sortOrder": "desc",
        "limit": 12
      },
      "chart": {
        "type": "bar",
        "subtype": "grouped",
        "orientation": "vertical"
      },
      "echartsOption": {
        "tooltip": {
          "trigger": "axis"
        },
        "xAxis": {
          "type": "category"
        },
        "yAxis": {
          "type": "value"
        },
        "series": [
          {
            "type": "bar"
          }
        ]
      }
    },
    {
      "id": "k1",
      "title": "销售额",
      "type": "kpi",
      "layout": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasetId": "ds1",
      "encode": {
        "measures": [
          {
            "field": "sales_amount",
            "agg": "sum",
            "role": "value"
          }
        ]
      },
      "format": {
        "prefix": "¥",
        "precision": 0
      }
    },
    {
      "id": "t1",
      "title": "明细",
      "type": "table",
      "layout": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "datasetId": "ds1",
      "encode": {
        "limit": 100,
        "pageSize": 20,
        "columns": [
          {
            "field": "month_name",
            "label": "月份",
            "width": 160
          },
          {
            "field": "sales_amount",
            "label": "销售额",
            "width": 180
          }
        ]
      }
    }
  ],
  "filters": [
    {
      "id": "date_range",
      "type": "dateRange",
      "targets": [
        {
          "datasetId": "ds1",
          "mode": "server",
          "pushdown": {
            "kind": "metricTime"
          }
        }
      ]
    }
  ]
}
