      ".name": "StreamSqlUnit",
      ".class": "com.yonyou.datad.spark.preproc.StreamSqlUnit",
      "sql": "SELECT \n  result.user_id, \n  result.username, \n  sum(result.order_amount) as order_amount\nFROM (\nselect u.user_id,u.username,stream.order_amount from \n  main.order_info stream\nleft JOIN mysql.source.user u ON u.user_id = stream.user_id \nUNION  all \n  select dws.user_id,dws.username,dws.order_amount from mysql.\"source\".dws_order dws where dws.user_id in ( select user_id from main.order_info)\n) result\nGROUP BY result.user_id ,result.username;"
    },
