{
  "format": "datay-etl-task",
  "version": "1.0",
  "task": {
    "taskName": "MySQL 同步到 Apache Doris",
    "taskCode": "tmpl_mysql_to_doris",
    "taskDesc": "从 MySQL 读取业务表，通过 Doris Stream Load 写入 Doris。导入后需要把「模板-Doris」数据源改为可用的 Doris 连接，并确认 FE HTTP 端点（extraParams.fe_endpoint）。",
    "dir": "/集成模板",
    "type": "ETL",
    "cron": "",
    "retryCount": 0,
    "timeoutSeconds": 0,
    "priority": 2,
    "project": "template",
    "nodes": [
      {
        "label": "读取 MySQL 源表",
        "code": "n1",
        "desc": "从模板-MySQL源库 source.common_data_types 读取数据",
        "type": "StreamJdbcInput",
        "config": {
          "sourceId": "tmpl-mysql-source",
          "schema": "source",
          "table": "common_data_types"
        },
        "xAxis": "120",
        "yAxis": "160",
        "status": "0"
      },
      {
        "label": "Doris Stream Load 写入",
        "code": "n2",
        "desc": "通过 Stream Load 写入模板-Doris demo.common_data_types",
        "type": "DorisStreamLoad",
        "config": {
          "sourceId": "tmpl-doris",
          "schema": "demo",
          "table": "common_data_types",
          "model": "insert"
        },
        "xAxis": "560",
        "yAxis": "160",
        "status": "0"
      }
    ],
    "edges": [
      {
        "name": "",
        "code": "e1",
        "source": "n1",
        "target": "n2",
        "config": null,
        "status": "0"
      }
    ]
  },
  "references": {
    "dataSources": [
      {
        "oldId": "tmpl-mysql-source",
        "name": "模板-MySQL源库",
        "type": "MYSQL",
        "url": "jdbc:mysql://127.0.0.1:3306/source?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai"
      },
      {
        "oldId": "tmpl-doris",
        "name": "模板-Doris",
        "type": "DORIS",
        "url": "jdbc:mysql://127.0.0.1:9030/demo?useSSL=false&allowPublicKeyRetrieval=true"
      }
    ],
    "models": []
  }
}
