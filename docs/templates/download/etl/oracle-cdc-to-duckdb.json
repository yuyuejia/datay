{
  "format": "datay-etl-task",
  "version": "1.0",
  "task": {
    "taskName": "Oracle CDC 实时同步到 DuckDB",
    "taskCode": "tmpl_oracle_cdc_to_duckdb",
    "taskDesc": "基于 LogMiner 捕获 Oracle 变更并写入 DuckDB。前置要求：数据库开启归档日志和补充日志，采集账号具备 LOGMINING 权限。",
    "dir": "/集成模板",
    "type": "ETL",
    "cron": "",
    "retryCount": 0,
    "timeoutSeconds": 0,
    "priority": 2,
    "project": "template",
    "nodes": [
      {
        "label": "采集 Oracle 变更",
        "code": "n1",
        "desc": "通过 LogMiner 采集 DATAY.ORDERS 的增量变更",
        "type": "OracleCDCInput",
        "config": {
          "sourceId": "tmpl-oracle-source",
          "schema": "DATAY",
          "tableNamePattern": "ORDERS",
          "pollIntervalMs": 1000,
          "snapshot": true,
          "snapshotFetchSize": 10000,
          "ignoreError": true,
          "reconnectMaxAttempts": 5,
          "reconnectIntervalMs": 3000
        },
        "xAxis": "120",
        "yAxis": "160",
        "status": "0"
      },
      {
        "label": "写入 DuckDB 数仓",
        "code": "n2",
        "desc": "写入模板-DuckDB数仓 main 下与上游同名的表，模式 auto",
        "type": "StreamJdbcOutput",
        "config": {
          "sourceId": "tmpl-duckdb-dw",
          "schema": "main",
          "table": "",
          "model": "auto"
        },
        "xAxis": "560",
        "yAxis": "160",
        "status": "0"
      }
    ],
    "edges": [
      {
        "name": "",
        "code": "e1",
        "source": "n1",
        "target": "n2",
        "config": null,
        "status": "0"
      }
    ]
  },
  "references": {
    "dataSources": [
      {
        "oldId": "tmpl-oracle-source",
        "name": "模板-Oracle源库",
        "type": "ORACLE",
        "url": "jdbc:oracle:thin:@//127.0.0.1:1521/FREEPDB1"
      },
      {
        "oldId": "tmpl-duckdb-dw",
        "name": "模板-DuckDB数仓",
        "type": "DUCKDB",
        "url": "jdbc:duckdb:./data/template_dw.duckdb"
      }
    ],
    "models": []
  }
}
