{
  "format": "datay-etl-task",
  "version": "1.0",
  "task": {
    "taskName": "MySQL 同步到 DuckLake 数据湖",
    "taskCode": "tmpl_mysql_to_ducklake",
    "taskDesc": "从 MySQL 读取业务表，覆盖写入本地 DuckLake。导入后请把「模板-DuckLake」数据源改为你的 DuckLake 连接（含 S3 / 元数据库参数）。",
    "dir": "/集成模板",
    "type": "ETL",
    "cron": "",
    "retryCount": 0,
    "timeoutSeconds": 0,
    "priority": 2,
    "project": "template",
    "nodes": [
      {
        "label": "读取 MySQL 源表",
        "code": "n1",
        "desc": "从模板-MySQL源库 source.common_data_types 读取数据",
        "type": "StreamJdbcInput",
        "config": {
          "sourceId": "tmpl-mysql-source",
          "schema": "source",
          "table": "common_data_types"
        },
        "xAxis": "120",
        "yAxis": "160",
        "status": "0"
      },
      {
        "label": "写入 DuckLake",
        "code": "n2",
        "desc": "写入模板-DuckLake main.common_data_types，模式 overwrite",
        "type": "DuckLakeWrite",
        "config": {
          "sourceId": "tmpl-ducklake",
          "schema": "main",
          "table": "common_data_types",
          "model": "overwrite"
        },
        "xAxis": "560",
        "yAxis": "160",
        "status": "0"
      }
    ],
    "edges": [
      {
        "name": "",
        "code": "e1",
        "source": "n1",
        "target": "n2",
        "config": null,
        "status": "0"
      }
    ]
  },
  "references": {
    "dataSources": [
      {
        "oldId": "tmpl-mysql-source",
        "name": "模板-MySQL源库",
        "type": "MYSQL",
        "url": "jdbc:mysql://127.0.0.1:3306/source?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai"
      },
      {
        "oldId": "tmpl-ducklake",
        "name": "模板-DuckLake",
        "type": "DUCKLAKE",
        "url": "ducklake:./data/template_lake.ducklake"
      }
    ],
    "models": []
  }
}
