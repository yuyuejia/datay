{
  "format": "datay-etl-task",
  "version": "1.0",
  "task": {
    "taskName": "MySQL 全量同步到 MySQL",
    "taskCode": "tmpl_mysql_to_mysql",
    "taskDesc": "最基础的库表全量同步：从 MySQL 源库读取整表，覆盖写入 MySQL 目标库。导入后请核对源/目标数据源、schema 和表名，目标表不存在时会按源表结构自动建表。",
    "dir": "/集成模板",
    "type": "ETL",
    "cron": "",
    "retryCount": 0,
    "timeoutSeconds": 0,
    "priority": 2,
    "project": "template",
    "nodes": [
      {
        "label": "读取 MySQL 源表",
        "code": "n1",
        "desc": "从模板-MySQL源库 source.common_data_types 读取数据",
        "type": "StreamJdbcInput",
        "config": {
          "sourceId": "tmpl-mysql-source",
          "schema": "source",
          "table": "common_data_types"
        },
        "xAxis": "120",
        "yAxis": "160",
        "status": "0"
      },
      {
        "label": "写入 MySQL 目标表",
        "code": "n2",
        "desc": "写入模板-MySQL目标库 target.common_data_types，模式 overwrite",
        "type": "StreamJdbcOutput",
        "config": {
          "sourceId": "tmpl-mysql-target",
          "schema": "target",
          "table": "common_data_types",
          "model": "overwrite"
        },
        "xAxis": "560",
        "yAxis": "160",
        "status": "0"
      }
    ],
    "edges": [
      {
        "name": "",
        "code": "e1",
        "source": "n1",
        "target": "n2",
        "config": null,
        "status": "0"
      }
    ]
  },
  "references": {
    "dataSources": [
      {
        "oldId": "tmpl-mysql-source",
        "name": "模板-MySQL源库",
        "type": "MYSQL",
        "url": "jdbc:mysql://127.0.0.1:3306/source?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai"
      },
      {
        "oldId": "tmpl-mysql-target",
        "name": "模板-MySQL目标库",
        "type": "MYSQL",
        "url": "jdbc:mysql://127.0.0.1:3306/target?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai"
      }
    ],
    "models": []
  }
