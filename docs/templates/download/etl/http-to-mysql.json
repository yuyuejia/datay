{
  "format": "datay-etl-task",
  "version": "1.0",
  "task": {
    "taskName": "HTTP 监听写入 MySQL",
    "taskCode": "tmpl_http_listener_to_mysql",
    "taskDesc": "启动一个 HTTP 监听端口，外部系统 POST 数据后实时写入 MySQL。适合 webhook、事件回调和轻量实时接入；导入后修改端口、路径和目标数据源。",
    "dir": "/集成模板",
    "type": "ETL",
    "cron": "",
    "retryCount": 0,
    "timeoutSeconds": 0,
    "priority": 2,
    "project": "template",
    "nodes": [
      {
        "label": "监听 HTTP 请求",
        "code": "n1",
        "desc": "监听 8085 端口 /ingest 路径",
        "type": "HttpListener",
        "config": {
          "port": 8085,
          "host": "0.0.0.0",
          "path": "/ingest",
          "enableHttps": false,
          "maxBodySize": 10485760,
          "dataFormat": "AUTO"
        },
        "xAxis": "120",
        "yAxis": "160",
        "status": "0"
      },
      {
        "label": "写入 MySQL",
        "code": "n2",
        "desc": "写入模板-MySQL目标库 target.http_ingest，模式 append",
        "type": "StreamJdbcOutput",
        "config": {
          "sourceId": "tmpl-mysql-target",
          "schema": "target",
          "table": "http_ingest",
          "model": "append"
        },
        "xAxis": "560",
        "yAxis": "160",
        "status": "0"
      }
    ],
    "edges": [
      {
        "name": "",
        "code": "e1",
        "source": "n1",
        "target": "n2",
        "config": null,
        "status": "0"
      }
    ]
  },
  "references": {
    "dataSources": [
      {
        "oldId": "tmpl-mysql-target",
        "name": "模板-MySQL目标库",
        "type": "MYSQL",
        "url": "jdbc:mysql://127.0.0.1:3306/target?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai"
      }
    ],
    "models": []
  }
}
